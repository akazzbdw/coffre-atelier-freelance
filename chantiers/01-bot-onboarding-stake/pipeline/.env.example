# Un fichier par influenceur : copier en .env.jd ET .env.clive sur la machine
# qui héberge — JAMAIS commités (.env* est gitignoré).
# Laisser une ligne vide ou commentée = le bot REFUSE de démarrer (c'est voulu).

# l'influenceur servi par ce bot (apparaît dans les demandes de bonus)
BOT_NOM=JD
# jeton du bot — créé chez @BotFather par Zakaria, propriété transférée à Sofiane ensuite
TELEGRAM_BOT_TOKEN=
# le lien de parrainage DE CET influenceur (envoyé par Sofiane le 17/09) — doit commencer par http
STAKE_LIEN_PARRAINAGE=
# le VPN gratuit recommandé par Sofiane (appel du 19/09)
VPN_NOM=Windscribe
# qui reçoit les demandes de bonus (identifiant Telegram numérique) : Zakaria d'abord, Sofiane ensuite
